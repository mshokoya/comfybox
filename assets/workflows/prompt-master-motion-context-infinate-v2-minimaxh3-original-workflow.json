1.mp4\",\"file_name\":\"video_0_1.mp4\",\"media_revision\":\"1787813331098915200\",\"source_start_frame\":0,\"source_end_frame\":243,\"source_frame_count\":243,\"continuity_mode\":\"shot\",\"enabled\":true,\"video_files\":[{\"file_path\":\"easy_media/projects/default/video_0_1.mp4\",\"file_name\":\"video_0_1.mp4\",\"media_revision\":\"1787813331098915200\",\"source_frame_count\":243}]},{\"id\":\"segment-1\",\"index\":1,\"file_path\":\"easy_media/projects/default/video_1_1.mp4\",\"file_name\":\"video_1_1.mp4\",\"media_revision\":\"1787813612012529700\",\"source_start_frame\":0,\"source_end_frame\":243,\"source_frame_count\":243,\"continuity_mode\":\"context\",\"enabled\":true,\"video_files\":[{\"file_path\":\"easy_media/projects/default/video_1_1.mp4\",\"file_name\":\"video_1_1.mp4\",\"media_revision\":\"1787813612012529700\",\"source_frame_count\":243}]}],\"auto_combine\":true,\"updated_at\":1787813656.4849267}"}},{"id":32,"type":"Note","pos":[2575.1145003044326,2182.3654534480434],"size":[430,150],"flags":{},"order":6,"mode":0,"inputs":[],"outputs":[],"properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["MODEL STACK\n==========================\nBase model : Minimax-h3_Singularity_ref2va_v1.3_int8  (ref2v fine-tune)\nLoRA       : minimax_h3_ref2v_turbo_4step_v0.1   strength 1.0\nSampling   : BasicScheduler (beta, adjustable steps) + euler\nMode       : SINGLE pass  — one sampling pass, no second pass\n\n* Singularity pairs with the 4-step v0.1 LoRA only. Don't swap in the 8-step LoRA.\n* Singularity is a reference-to-video specialist. For plain image-to-video,\n  use a hybrid base model instead."],"widgets_values_named":{"text":"MODEL STACK\n==========================\nBase model : Minimax-h3_Singularity_ref2va_v1.3_int8  (ref2v fine-tune)\nLoRA       : minimax_h3_ref2v_turbo_4step_v0.1   strength 1.0\nSampling   : BasicScheduler (beta, adjustable steps) + euler\nMode       : SINGLE pass  — one sampling pass, no second pass\n\n* Singularity pairs with the 4-step v0.1 LoRA only. Don't swap in the 8-step LoRA.\n* Singularity is a reference-to-video specialist. For plain image-to-video,\n  use a hybrid base model instead."},"color":"#432","bgcolor":"#653"},{"id":34,"type":"Note","pos":[2414.2535435644963,2401.242378389111],"size":[620,680],"flags":{},"order":7,"mode":0,"inputs":[],"outputs":[],"properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["H3 LONG TAKE — Motion Context V2 (local)\n==========================================\n\nSAMPLING\n  sampling_mode = single     <- NOT dual. This is the whole trick.\n  Tested: continuing a chain off dual-pass latents gives pixel shift at\n  the joins. Single pass joins clean. For long takes, always single.\n  1st_pass_only / disable_2nd_noise only affect the second pass.\n  In single mode they do nothing — leave them.\n\nSTEPS (green BasicScheduler node)\n  8   default. Dancing, fast hands, busy backgrounds, walking + talking\n  6   low motion: talking head, slow walk, locked camera\n  4   runs, but dialogue drops syllables. Only with no speech.\n\nRESOLUTION\n  1.0 MP  fast, safe default for iteration\n  1.4 MP  up to ~10 s per segment on a 24-32 GB card\n  Past ~1.2-1.4 MP you mostly buy size, not detail.\n  VRAM rule of thumb: frames x megapixels <= ~540 per segment.\n\nMULTI-TRACK EDITOR\n  Segment 1 = \"shot\".  Every later segment = \"context\".\n  ref_image_size = max\n  Put the reference image on segment 1 -> hover it -> Share icon ->\n  \"Use as shared reference\". Later segments inherit it automatically.\n\nPROJECT SETTINGS (Multi-Track Project node)\n  project_name          always name it (empty = \"default\")\n  segment_start_number  counts from 1\n  segment_count         -1 = from start segment to the end\n  Re-render ONE segment: start = N, count = 1  (local only —\n  the saved context latents live in output/easy_media/projects/<name>/)\n\nPROMPTS\n  - A context segment's timestamps land ~0.92 s early in the final\n    video (22 pinned frames are trimmed). Write T + 0.92 to land at T.\n  - Open every context segment with CONTINUATION only — same pace,\n    same camera, same light — and zero scenery nouns.\n  - Never carry a progressive camera move across a join.\n  - Put joins mid-walk / mid-climb, never on a doorway or threshold.\n  - Dialogue: ~one short line every 2.5 s. Split between sentences."],"widgets_values_named":{"text":"H3 LONG TAKE — Motion Context V2 (local)\n==========================================\n\nSAMPLING\n  sampling_mode = single     <- NOT dual. This is the whole trick.\n  Tested: continuing a chain off dual-pass latents gives pixel shift at\n  the joins. Single pass joins clean. For long takes, always single.\n  1st_pass_only / disable_2nd_noise only affect the second pass.\n  In single mode they do nothing — leave them.\n\nSTEPS (green BasicScheduler node)\n  8   default. Dancing, fast hands, busy backgrounds, walking + talking\n  6   low motion: talking head, slow walk, locked camera\n  4   runs, but dialogue drops syllables. Only with no speech.\n\nRESOLUTION\n  1.0 MP  fast, safe default for iteration\n  1.4 MP  up to ~10 s per segment on a 24-32 GB card\n  Past ~1.2-1.4 MP you mostly buy size, not detail.\n  VRAM rule of thumb: frames x megapixels <= ~540 per segment.\n\nMULTI-TRACK EDITOR\n  Segment 1 = \"shot\".  Every later segment = \"context\".\n  ref_image_size = max\n  Put the reference image on segment 1 -> hover it -> Share icon ->\n  \"Use as shared reference\". Later segments inherit it automatically.\n\nPROJECT SETTINGS (Multi-Track Project node)\n  project_name          always name it (empty = \"default\")\n  segment_start_number  counts from 1\n  segment_count         -1 = from start segment to the end\n  Re-render ONE segment: start = N, count = 1  (local only —\n  the saved context latents live in output/easy_media/projects/<name>/)\n\nPROMPTS\n  - A context segment's timestamps land ~0.92 s early in the final\n    video (22 pinned frames are trimmed). Write T + 0.92 to land at T.\n  - Open every context segment with CONTINUATION only — same pace,\n    same camera, same light — and zero scenery nouns.\n  - Never carry a progressive camera move across a join.\n  - Put joins mid-walk / mid-climb, never on a doorway or threshold.\n  - Dialogue: ~one short line every 2.5 s. Split between sentences."},"color":"#432","bgcolor":"#653"},{"id":15,"type":"easy multitrackProject","pos":[3911.0050921393554,2452.8031912501565],"size":[273.552734375,502],"flags":{},"order":16,"mode":0,"inputs":[{"name":"tracks_info","type":"TRACKS_INFO","link":60},{"name":"model_loader","type":"FAST_MODEL_LOADER","link":18},{"name":"model_loader_2nd","shape":7,"type":"FAST_MODEL_LOADER","link":null},{"name":"sampler","shape":7,"type":"SAMPLER","link":70},{"name":"sampler_2nd","shape":7,"type":"SAMPLER","link":71},{"name":"sigmas","shape":7,"type":"SIGMAS","link":68},{"name":"sigmas_2nd","shape":7,"type":"SIGMAS","link":69}],"outputs":[{"name":"PROJECT_NAME","type":"STRING","links":[19]},{"name":"LOCKED_AUDIO","type":"AUDIO","links":[]}],"properties":{"cnr_id":"comfyui-easy-media","ver":"5739638c646a66a93d60c51714593b2b96a2a3b6","Node name for S&R":"easy multitrackProject","ue_properties":{"widget_ue_connectable":{"project_name":true,"project_save":true,"segment_start_number":true,"segment_count":true,"seed":true,"sampling_plan":true,"sampling_mode":true,"1st_pass_only":true,"disable_2nd_noise":true,"upscale_by":true,"upscale_model":true},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["longtake_demo","override",1,-1,526360739808631,"randomize","custom","single",false,false,1.5,"None"],"widgets_values_named":{"project_name":"longtake_demo","project_save":"override","segment_start_number":1,"segment_count":-1,"seed":526360739808631,"fixed":"randomize","sampling_plan":"custom","sampling_mode":"single","1st_pass_only":false,"disable_